{
  "name": "agentready-framer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/validate-runtime.ts && tsx scripts/validate-mcp-gateway.ts && tsx scripts/validate-cloudflare-headers.ts && tsx scripts/validate-intelligence-worker.ts",
    "test:live": "tsx scripts/validate-live.ts",
    "check:demo": "esbuild framer/AgentReadyPlayground.tsx --bundle --external:framer --external:react --outfile=/tmp/agentready-playground.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "pack": "npx framer-plugin-tools@latest pack"
  },
  "dependencies": {
    "@framer/plugin": "^4",
    "react": "^18",
    "react-dom": "^18",
    "vite-plugin-mkcert": "^1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^26.4.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9",
    "typescript-eslint": "^8.0.1",
    "vite": "^8",
    "vite-plugin-framer": "^1.1.0"
  }
}
