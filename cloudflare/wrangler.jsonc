{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentready-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "AgentReadySession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentReadySession"] }],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "agentready-uploads" }],
  "vars": {
    "ALLOWED_ORIGINS": "https://example.framer.website",
    "MAX_UPLOAD_BYTES": "10485760"
  },
  "observability": { "enabled": true }
}
