{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentready-crawl-pricing",
  "main": "src/crawl-pricing.ts",
  "compatibility_date": "2026-09-03",
  "vars": {
    "CRAWLER_PRICE": "USD 0.01",
    "PAID_PATH_PREFIXES": "/articles/,/research/,/agentready/content.json",
    "FRAMER_ORIGIN": "https://agentready.framer.website",
    "CONTENT_LICENSE_ID": "agentready-site-policy-v1",
    "CONTENT_LICENSE_URL": "https://example.com/content-license",
    "CONTENT_USE": "reference",
    "PERMITTED_PURPOSES": "search,ai-input"
  },
  "observability": { "enabled": true }
}
