{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentready-agentic-payments",
  "main": "src/payments.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "https://example.framer.website",
    "MPP_RECIPIENT": "0x0000000000000000000000000000000000000000",
    "MPP_CURRENCY": "0x20c0000000000000000000000000000000000000",
    "OFFER_AMOUNT": "0.01"
  },
  "observability": { "enabled": true }
}
